# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate fresh values for each environment, never reuse across environments.
# You can generate a batch with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me

# Database (MySQL — matches your cPanel "MySQL Databases" credentials)
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=dreamspace
DATABASE_USERNAME=dreamspace
DATABASE_PASSWORD=changeme
DATABASE_SSL=false
